{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@modules/*": ["./src/modules/*"],
      "@utils/*": ["./src/utils/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@api/*": ["./src/api/*"],
      "@config/*": ["./src/config/*"],
      "@testdata/*": ["./src/testdata/*"]
    }
  },
  "include": ["playwright.config.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results", "allure-results", "allure-report"]
}
